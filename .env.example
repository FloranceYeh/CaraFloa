# Use the public origin of the deployed site so RSS links are absolute.
PUBLIC_SITE_URL=https://your-domain.example

# Waline server URL, for example https://comments.example.com
# PUBLIC_WALINE_SERVER_URL=https://comments.example.com

# Optional: local content repository (articles/, config/, images/), watched during dev.
# Relative paths are resolved from the site project root. Absolute paths also work.
# CONTENT_SOURCE_DIR=../CaraFloa-content
