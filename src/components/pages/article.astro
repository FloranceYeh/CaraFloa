---
import "../../styles/components/pages/article.css";
import "katex/dist/katex.min.css";
import "remark-github-blockquote-alert/alert.css";
import { render } from "astro:content";
import { articleSection, getArticles, homeSections } from "../../lib/articles";
import { formatSiteDateTime } from "../../lib/date";

interface Props {
  section: string;
  articleId: string;
}

const { section, articleId } = Astro.props;
const allArticles = await getArticles();
const sectionData = homeSections.find((s) => s.id === section);
const article = allArticles.find(
  (candidate) =>
    articleSection(candidate) === section &&
    candidate.data.id === articleId &&
    candidate.data.publishedAt.getTime() <= Date.now(),
);
const Content = article ? (await render(article)).Content : undefined;
---

<div class="article-wrapper">
  <div class="toolbar">
    <div class="upper-tools">
      <button class="toolbar-item to-top" type="button" aria-label="回到顶部">
        <i class="fa-solid fa-arrow-up"></i>
      </button>
      <button class="toolbar-item to-bottom" type="button" aria-label="回到底部">
        <i class="fa-solid fa-arrow-down"></i>
      </button>
    </div>
    <div class="lower-tools">
      <a
        class="toolbar-item discuss"
        href={`/comments/${section}/${articleId}`}
        aria-label="查看评论"
      >
        <i class="fa-solid fa-message"></i>
      </a>
    </div>
  </div>

  <div class="articles">
    {article && Content && (
      <article class="article" data-article-id={article.data.id} aria-label={article.data.title}>
        <div class="article-body">
          <header class="article-header">
            <span class="article-section-label">{sectionData?.title}</span>
          </header>
          <h1 class="article-title">{article.data.title}</h1>
          {article.data.summary && <p class="article-summary">{article.data.summary}</p>}
          <time class="article-date" datetime={article.data.publishedAt.toISOString()}>
            <i class="fa-regular fa-calendar" aria-hidden="true"></i>
            {formatSiteDateTime(article.data.publishedAt)}
          </time>
          {article.data.tags.length > 0 && (
            <div class="article-tags" aria-label="文章标签">
              <i class="fa-solid fa-tags" aria-hidden="true"></i>
              {article.data.tags.map((tag) => (
                <span>#{tag}</span>
              ))}
            </div>
          )}
          <div class="article-content">
            <Content />
          </div>
        </div>
      </article>
    )}
  </div>
</div>
