---
import "../../styles/components/pages/article.css";
import { render } from "astro:content";
import { articleSection, getArticles, homeSections } from "../../lib/articles";

interface Props {
  section: string;
  articleId: string;
}

const { section, articleId } = Astro.props;
const allArticles = await getArticles();
const sectionData = homeSections.find((s) => s.id === section);
const article = allArticles.find(
  (candidate) =>
    articleSection(candidate) === section &&
    candidate.data.id === articleId &&
    candidate.data.publishedAt.getTime() <= Date.now(),
);
const Content = article ? (await render(article)).Content : undefined;
---

<div class="article-wrapper">
  <div class="toolbar">
    <div class="upper-tools">
      <div class="toolbar-item to-top">
        <i class="fa-solid fa-arrow-up"></i>
      </div>
      <div class="toolbar-item to-bottom">
        <i class="fa-solid fa-arrow-down"></i>
      </div>
    </div>
    <div class="lower-tools">
      <div class="toolbar-item zoom">
        <i class="fa-solid fa-down-left-and-up-right-to-center"></i>
      </div>
    </div>
  </div>

  <div class="articles">
    {article && Content && (
      <article class="article" data-article-id={article.data.id} aria-label={article.data.title}>
        <div class="article-body">
          <header class="article-header">
            <span class="article-section-label">{sectionData?.title}</span>
          </header>
          <h1 class="article-title">{article.data.title}</h1>
          {article.data.summary && <p class="article-summary">{article.data.summary}</p>}
          <time class="article-date" datetime={article.data.publishedAt.toISOString()}>
            {article.data.publishedAt.toLocaleString("zh-CN")}
          </time>
          <div class="article-content">
            <Content />
          </div>
        </div>
      </article>
    )}
  </div>
</div>
