---
import "../../styles/components/pages/home.css";
import {
  getArticles,
  articleSection,
  latestArticleForSection,
  latestPublishedArticle,
  sectionArticle,
  homeSections,
} from "../../lib/articles";

const articles = await getArticles();
const now = new Date();
const defaultArticle = latestPublishedArticle(articles, now);
const defaultIndex = Math.max(
  0,
  homeSections.findIndex(
    (section) => section.id === (defaultArticle ? articleSection(defaultArticle) : undefined),
  ),
);
const cards = homeSections.map((section) => {
  const sectionArticles = sectionArticle(articles, section);
  const article = latestArticleForSection(articles, section, now);
  const nextArticle = sectionArticles.find(
    (entry) => entry.data.publishedAt.getTime() > now.getTime(),
  );
  return { section, article, nextArticle };
});
---

<div class="home-view">
  <div class="home-track" tabindex="0" style={`--active-column: ${defaultIndex}`}>
    {cards.map(({ section, article, nextArticle }, index) => (
      <article
        class:list={["home-card", { "is-pending": !article }]}
        data-index={index}
        data-section={section.id}
        data-next-published-at={nextArticle?.data.publishedAt.toISOString()}
        aria-label={section.title || `Section ${index + 1}`}
      >
        <div class="home-card-body">
          <span class="home-card-index">{String(index + 1).padStart(2, "0")}</span>
          <h2 class="home-section-title">{section.title}</h2>
          <div class="home-card-content" data-state={article ? "published" : "pending"}>
            {article ? (
              <>
                <a class="home-card-link" href={`/${section.id}/${article.data.id}`}>
                  <strong>{article.data.title}</strong>
                </a>
                <p>{article.data.summary || section.summary}</p>
                <time datetime={article.data.publishedAt.toISOString()}>
                  {article.data.publishedAt.toLocaleString("zh-CN")}
                </time>
              </>
            ) : (
              <p class="home-card-pending">等待更新</p>
            )}
          </div>
        </div>
      </article>
    ))}
  </div>
  <div class="dots-container">
    <div class="home-dots" role="tablist">
      {homeSections.map((section, index) => (
        <button
          class:list={["home-dot", { active: index === defaultIndex }]}
          type="button"
          role="tab"
          aria-label={`Section ${index + 1}`}
          aria-selected={index === defaultIndex}
          data-index={index}
        />
      ))}
    </div>
  </div>
</div>
<script>
  const setupHome = () => {
    const track = document.querySelector<HTMLElement>(".home-track");
    const cards = [...document.querySelectorAll<HTMLElement>(".home-card")];
    const dots = [...document.querySelectorAll<HTMLButtonElement>(".home-dot")];
    if (!track || !cards.length) return;
    let current = Number(track.style.getPropertyValue("--active-column")) || 0;
    const update = (next: number) => {
      current = Math.max(0, Math.min(cards.length - 1, next));
      track.style.setProperty("--active-column", String(current));
      cards.forEach((card, index) => card.setAttribute("aria-hidden", String(index !== current)));
      dots.forEach((dot, index) => {
        dot.classList.toggle("active", index === current);
        dot.setAttribute("aria-selected", String(index === current));
      });
    };
    const refreshPending = () => {
      const now = Date.now();
      cards.forEach((card) => {
        const nextAt = card.dataset.nextPublishedAt
          ? Date.parse(card.dataset.nextPublishedAt)
          : NaN;
        if (!Number.isNaN(nextAt) && nextAt <= now && card.querySelector('[data-state="pending"]'))
          window.location.reload();
      });
    };
    dots.forEach((dot) => dot.addEventListener("click", () => update(Number(dot.dataset.index))));
    let startX = 0;
    track.addEventListener("pointerdown", (event) => {
      startX = event.clientX;
      track.setPointerCapture(event.pointerId);
    });
    track.addEventListener("pointerup", (event) => {
      const delta = event.clientX - startX;
      if (Math.abs(delta) > 40) update(current + (delta < 0 ? 1 : -1));
    });
    track.addEventListener(
      "wheel",
      (event) => {
        if (Math.abs(event.deltaX) > Math.abs(event.deltaY) || Math.abs(event.deltaY) > 20) {
          event.preventDefault();
          update(current + (event.deltaX + event.deltaY > 0 ? 1 : -1));
        }
      },
      { passive: false },
    );
    track.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight") update(current + 1);
      if (event.key === "ArrowLeft") update(current - 1);
    });
    update(current);
    refreshPending();
    window.setInterval(refreshPending, 30000);
  };
  setupHome();
</script>
