---
import "../../styles/components/pages/home.css";
import { homeSections } from "../../config/home";
import {
  articleSection,
  getArticles,
  latestArticleForSection,
  latestPublishedArticle,
  latestPublishedPeriod,
  sectionArticle,
} from "../../lib/articles";

const now = new Date();
const articles = await getArticles();
const currentPeriod = latestPublishedPeriod(articles, now);
const publishedHomeArticles = articles.filter(
  (article) =>
    homeSections.some((section) => section.id === articleSection(article)) &&
    article.data.publishedAt.getTime() <= now.getTime(),
);
const homeArticles = currentPeriod
  ? articles.filter((article) => article.data.period === currentPeriod)
  : articles;
const formatDateTime = (date: Date) =>
  date.toLocaleString("zh-CN", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
    hour12: false,
  });
const cards = homeSections.map((section) => ({
  section,
  article: latestArticleForSection(homeArticles, section, now),
  nextArticle: sectionArticle(homeArticles, section)
    .filter((a) => a.data.publishedAt.getTime() > now.getTime())
    .sort((a, b) => a.data.publishedAt.getTime() - b.data.publishedAt.getTime())[0],
}));
const latestHomeArticle = latestPublishedArticle(
  publishedHomeArticles.filter(
    (article) => !currentPeriod || article.data.period === currentPeriod,
  ),
  now,
);
const latestHomeSection = latestHomeArticle && articleSection(latestHomeArticle);
const latestHomeIndex = cards.findIndex(({ section }) => section.id === latestHomeSection);
const defaultIndex = latestHomeIndex >= 0 ? latestHomeIndex : 0;
---

<div class="home-view">
  <div class="home-track" tabindex="0" style={`--active-column: ${defaultIndex}`}>
    {cards.map(({ section, article, nextArticle }, index) => (
      <article
        class:list={["home-card", { "is-active": index === defaultIndex, "is-pending": !article }]}
        data-index={index}
        data-section={section.id}
        data-next-published-at={nextArticle?.data.publishedAt.toISOString()}
        aria-label={section.title || `Section ${index + 1}`}
      >
        {article ? (
          <a class="home-card-body" href={`/${section.id}/${article.data.id}`}>
            {article.data.cover && (
              <img src={article.data.cover} alt="" aria-hidden="true" loading="lazy" />
            )}
            <span class="home-card-index">{String(index + 1).padStart(2, "0")}</span>
            <div class="home-section-title">{section.title}</div>
            <div class="home-card-content" data-state="published">
              <strong class="home-card-title">{article.data.title}</strong>
              <p>{article.data.summary || section.summary}</p>
              <time datetime={article.data.publishedAt.toISOString()}>
                {formatDateTime(article.data.publishedAt)}
              </time>
            </div>
          </a>
        ) : (
          <div class="home-card-body">
            <span class="home-card-index">{String(index + 1).padStart(2, "0")}</span>
            <h2 class="home-section-title">{section.title}</h2>
            <div class="home-card-content" data-state="pending">
              <p class="home-card-pending">等待更新</p>
            </div>
          </div>
        )}
      </article>
    ))}
  </div>
  <div class="dots-container">
    <div class="home-dots" role="tablist">
      {homeSections.map((section, index) => (
        <button
          class:list={["home-dot", { active: index === defaultIndex }]}
          type="button"
          role="tab"
          aria-label={`Section ${index + 1}`}
          aria-selected={index === defaultIndex}
          data-index={index}
        />
      ))}
    </div>
  </div>
</div>
<script>
  const setupHome = () => {
    const track = document.querySelector<HTMLElement>(".home-track");
    const cards = [...document.querySelectorAll<HTMLElement>(".home-card")];
    const dots = [...document.querySelectorAll<HTMLButtonElement>(".home-dot")];
    if (!track || !cards.length) return;

    let current = Number(track.style.getPropertyValue("--active-column")) || 0;

    const update = (next: number) => {
      current = Math.max(0, Math.min(cards.length - 1, next));
      track.style.setProperty("--active-column", String(current));
      cards.forEach((card, index) => {
        const isActive = index === current;
        card.classList.toggle("is-active", isActive);
        card.setAttribute("aria-hidden", String(!isActive));
      });
      dots.forEach((dot, index) => {
        dot.classList.toggle("active", index === current);
        dot.setAttribute("aria-selected", String(index === current));
      });
    };

    const refreshPending = () => {
      const now = Date.now();
      cards.forEach((card) => {
        const nextAt = card.dataset.nextPublishedAt
          ? Date.parse(card.dataset.nextPublishedAt)
          : NaN;
        if (!Number.isNaN(nextAt) && nextAt <= now && card.querySelector('[data-state="pending"]'))
          window.location.reload();
      });
    };

    dots.forEach((dot) => dot.addEventListener("click", () => update(Number(dot.dataset.index))));

    let dragState = {
      isDragging: false,
      startX: 0,
      startTime: 0,
    };

    const handleDragStart = (clientX: number, target: EventTarget | null) => {
      if ((target as HTMLElement).closest("a.home-card-body")) {
        return;
      }

      dragState = {
        isDragging: true,
        startX: clientX,
        startTime: Date.now(),
      };
    };

    const handleDragMove = (clientX: number, preventDefault: () => void) => {
      if (!dragState.isDragging) return;

      const deltaX = clientX - dragState.startX;
      if (Math.abs(deltaX) > 10) {
        preventDefault();
      }
    };

    const handleDragEnd = (clientX: number) => {
      if (!dragState.isDragging) return;

      const deltaX = clientX - dragState.startX;
      const deltaTime = Date.now() - dragState.startTime;

      if (Math.abs(deltaX) > 80) {
        update(current + (deltaX < 0 ? 1 : -1));
      }

      dragState.isDragging = false;
    };

    // 鼠标事件
    track.addEventListener("mousedown", (event) => {
      handleDragStart(event.clientX, event.target);
    });

    track.addEventListener("mousemove", (event) => {
      handleDragMove(event.clientX, () => event.preventDefault());
    });

    track.addEventListener("mouseup", (event) => {
      handleDragEnd(event.clientX);
    });

    track.addEventListener("mouseleave", () => {
      dragState.isDragging = false;
    });

    // 触摸事件
    track.addEventListener(
      "touchstart",
      (event) => {
        if (event.touches.length === 1) {
          handleDragStart(event.touches[0].clientX, event.target);
        }
      },
      { passive: true },
    );

    track.addEventListener(
      "touchmove",
      (event) => {
        if (event.touches.length === 1) {
          handleDragMove(event.touches[0].clientX, () => event.preventDefault());
        }
      },
      { passive: false },
    );

    track.addEventListener(
      "touchend",
      (event) => {
        if (event.changedTouches.length === 1) {
          handleDragEnd(event.changedTouches[0].clientX);
        }
      },
      { passive: true },
    );

    track.addEventListener("touchcancel", () => {
      dragState.isDragging = false;
    });

    let wheelLocked = false;
    track.addEventListener(
      "wheel",
      (event) => {
        if (Math.abs(event.deltaX) > Math.abs(event.deltaY) || Math.abs(event.deltaY) > 20) {
          event.preventDefault();
          if (wheelLocked) return;

          wheelLocked = true;
          update(current + (event.deltaX + event.deltaY > 0 ? 1 : -1));
          window.setTimeout(() => {
            wheelLocked = false;
          }, 350);
        }
      },
      { passive: false },
    );

    track.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight") update(current + 1);
      if (event.key === "ArrowLeft") update(current - 1);
    });

    update(current);
    refreshPending();
    window.setInterval(refreshPending, 30000);
  };
  setupHome();
</script>
