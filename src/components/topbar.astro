---
import "../styles/components/topbar.css";
import { getArticles, latestPublishedPeriod } from "../lib/articles";
import SiteLogoMark from "./site-logo.astro";

const articles = await getArticles();
const currentPeriod = latestPublishedPeriod(articles);
const brandSplitIndex = Math.ceil(SiteTitle.length / 2);

import { SiteTitle } from "@content-config/site";
---

<div class="topbar-wrapper">
  <div class="brand">
    <div class="brand-logo">
      <SiteLogoMark />
    </div>
    <div class="brand-name" aria-label={SiteTitle}>
      <span class="brand-name-first">{SiteTitle.slice(0, brandSplitIndex)}</span>
      <span class="brand-name-second">{SiteTitle.slice(brandSplitIndex)}</span>
    </div>
  </div>
  <div class="island">
    <div class="island-container">
      <div class="clock"></div>
      {currentPeriod ? (
        <div class="period">
          <i class="fa-solid fa-calendar-week" aria-hidden="true"></i>
          <span class="period-label">{currentPeriod.toUpperCase()}</span>
        </div>
      ) : null}
    </div>
  </div>
  <div class="tools">
    <!-- <div class="export">
      <i class="fa-solid fa-file-export" aria-hidden="true"></i>
      <div class="hint">Export</div>
    </div> -->
    <a class="rss" href="/rss.xml" aria-label="订阅 RSS">
      <i class="fa-solid fa-square-rss" aria-hidden="true"></i>
    </a>
  </div>
</div>

<script>
  const clockElement = document.querySelector(".clock");
  function updateClock() {
    const now = new Date();
    const hours = now.getHours().toString().padStart(2, "0");
    const minutes = now.getMinutes().toString().padStart(2, "0");
    if (clockElement) {
      clockElement.textContent = `${hours}:${minutes}`;
    }
  }
  setInterval(updateClock, 1000);
  updateClock();
</script>
