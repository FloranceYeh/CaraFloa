---
import "../styles/components/topbar.css";
import { getArticles, latestPublishedPeriod } from "../lib/articles";

const articles = await getArticles();
const currentPeriod = latestPublishedPeriod(articles);
---

<div class="topbar-wrapper">
  <div class="brand">
    <i class="fa-solid fa-house-flood-water"></i>
    <div class="brand-name">CaraFloa</div>
  </div>
  <div class="island">
    <div class="island-container">
      <div class="clock"></div>
      <div class="period">
        <i class="fa-solid fa-calendar-week" aria-hidden="true"></i>
        <span class="period-label">{currentPeriod?.toUpperCase() ?? "暂无周期"}</span>
      </div>
    </div>
  </div>
  <div class="tools">
    <!-- <div class="export">
      <i class="fa-solid fa-file-export" aria-hidden="true"></i>
      <div class="hint">Export</div>
    </div> -->
    <a class="rss" href="/rss.xml" aria-label="订阅 RSS" title="订阅 RSS">
      <i class="fa-solid fa-square-rss" aria-hidden="true"></i>
    </a>
  </div>
</div>

<script>
  const clockElement = document.querySelector(".clock");
  function updateClock() {
    const now = new Date();
    const hours = now.getHours().toString().padStart(2, "0");
    const minutes = now.getMinutes().toString().padStart(2, "0");
    if (clockElement) {
      clockElement.textContent = `${hours}:${minutes}`;
    }
  }
  setInterval(updateClock, 1000);
  updateClock();
</script>
