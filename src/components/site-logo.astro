<svg
  class="site-logo"
  xmlns="http://www.w3.org/2000/svg"
  viewBox="200 150 400 400"
  shape-rendering="geometricPrecision"
  role="img"
  aria-hidden="true"
>
  <defs>
    <linearGradient id="logo-mint-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="hsl(from var(--primary-color) h 70% 75%)" />
      <stop offset="50%" stop-color="hsl(from var(--primary-color) h 70% 50%)" />
      <stop offset="100%" stop-color="hsl(from var(--primary-color) h 70% 25%)" />
    </linearGradient>
    <linearGradient id="logo-iris-gradient" x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="hsl(from var(--primary-color) calc(h + 220) 70% 25%)" />
      <stop offset="50%" stop-color="hsl(from var(--primary-color) calc(h + 220) 70% 50%)" />
      <stop offset="100%" stop-color="hsl(from var(--primary-color) calc(h + 220) 70% 75%)" />
    </linearGradient>
  </defs>

  <g transform="translate(400 350)" filter="url(#logo-shadow)">
    <path
      d="M20-110C100-110 145-60 145 15c0 65-50 115-130 115-80 0-130-45-130-115"
      fill="none"
      stroke="url(#logo-iris-gradient)"
      stroke-width="44"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <path
      d="M85-75C-25-125-135-65-135 25c0 90 90 130 170 130 60 0 95-35 100-75"
      fill="none"
      stroke="url(#logo-mint-gradient)"
      stroke-width="44"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <path
      d="M-15 10H95"
      fill="none"
      stroke="url(#logo-mint-gradient)"
      stroke-width="40"
      stroke-linecap="round"
    />
    <path
      d="M10-60h95"
      fill="none"
      stroke="url(#logo-iris-gradient)"
      stroke-width="36"
      stroke-linecap="round"
    />
    <path
      d="M85-75C-25-125-135-65-135 25c0 90 90 130 170 130"
      fill="none"
      stroke="url(#logo-mint-gradient)"
      stroke-width="44"
      stroke-linecap="round"
    />
  </g>
</svg>
