---
import "../styles/components/page-content.css";

import { menu, type MenuItem } from "@content-config/menu";
import { pageGrid, getMainPages, type PageConfig } from "@content-config/pages";
import Home from "./pages/home.astro";
import Article from "./pages/article.astro";
import Comments from "./pages/comments.astro";
import About from "./pages/about.astro";
import Links from "./pages/links.astro";
import Archive from "./pages/archive.astro";
import NotFound from "./pages/not-found.astro";

interface Props {
  item?: MenuItem;
  section?: string;
  articleId?: string;
  view?: "article" | "comments";
  notFound?: boolean;
}
const { item = menu[0], section, articleId, view = "article", notFound = false } = Astro.props;
const isArticleView = !!(section && articleId && view === "article");
const isCommentsView = !!(section && articleId && view === "comments");
const normalizePagePath = (path: string) =>
  path === "/" ? "/" : `/${path.replace(/^\/+|\/+$/g, "")}`;
const getConfiguredPage = (path: string) =>
  pageGrid.find((page) => normalizePagePath(page.path) === path);
const notFoundPage = getConfiguredPage("/404");
const articlePage = getConfiguredPage("/article");
const commentsPage =
  getConfiguredPage("/comments") ??
  ({
    path: "/comments",
    gridX: articlePage?.gridX ?? 1,
    gridY: (articlePage?.gridY ?? 0) + 1,
    name: "Comments",
  } satisfies PageConfig);

const cellPosition = (page: PageConfig) => `left: ${page.gridX * 100}%; top: ${page.gridY * 100}%;`;

let cameraX = 0,
  cameraY = 0;
if (notFound) {
  if (notFoundPage) {
    cameraX = notFoundPage.gridX;
    cameraY = notFoundPage.gridY;
  }
} else if (isArticleView) {
  if (articlePage) {
    cameraX = articlePage.gridX;
    cameraY = articlePage.gridY;
  }
} else if (isCommentsView) {
  if (commentsPage) {
    cameraX = commentsPage.gridX;
    cameraY = commentsPage.gridY;
  }
} else {
  const currentPage = getConfiguredPage(normalizePagePath(item.path));
  if (currentPage) {
    cameraX = currentPage.gridX;
    cameraY = currentPage.gridY;
  }
}

const mainPages = getMainPages();
---

<main
  class="page-content"
  data-camera-x={cameraX}
  data-camera-y={cameraY}
  data-return-path={isCommentsView ? `/${section}/${articleId}` : undefined}
>
  <button class="return-button" aria-label="返回">
    <i class="fa-solid fa-chevron-left"></i>
  </button>
  <div class="return-button-hitbox"></div>
  <div class="page-background">
    <canvas class="background-canvas"></canvas>
  </div>
  <div class="page-grid-wrapper">
    <div class="page-grid" style={`--camera-x: ${cameraX}; --camera-y: ${cameraY}`}>
      {mainPages.map((page) => {
        const menuItem = menu.find((m) => m.path === page.path);
        return (
          <div
            class="page-cell"
            data-grid-x={page.gridX}
            data-grid-y={page.gridY}
            data-page-path={normalizePagePath(page.path)}
            style={cellPosition(page)}
          >
            {page.path === "/" ? (
              <Home />
            ) : page.path === "/archive" ? (
              <Archive />
            ) : page.path === "/about" ? (
              <About />
            ) : page.path === "/link" ? (
              <Links />
            ) : (
              <div class="page-cell-content">
                <div class="placeholder-card">
                  {menuItem && <i class={menuItem.icon} aria-hidden="true"></i>}
                  <span>{page.name}</span>
                </div>
              </div>
            )}
          </div>
        );
      })}

      {articlePage && (
        <div
          class="page-cell"
          data-grid-x={articlePage.gridX}
          data-grid-y={articlePage.gridY}
          data-page-path={normalizePagePath(articlePage.path)}
          style={cellPosition(articlePage)}
        >
          {(isArticleView || isCommentsView) && <Article section={section} articleId={articleId} />}
        </div>
      )}

      {commentsPage && (
        <div
          class="page-cell"
          data-grid-x={commentsPage.gridX}
          data-grid-y={commentsPage.gridY}
          data-page-path={normalizePagePath(commentsPage.path)}
          style={cellPosition(commentsPage)}
        >
          {isCommentsView && <Comments section={section} articleId={articleId} />}
        </div>
      )}

      {notFoundPage && (
        <div
          class="page-cell"
          data-grid-x={notFoundPage.gridX}
          data-grid-y={notFoundPage.gridY}
          data-page-path={normalizePagePath(notFoundPage.path)}
          style={cellPosition(notFoundPage)}
        >
          <NotFound />
        </div>
      )}
    </div>
  </div>
</main>

<script>
  const setupBackground = () => {
    const canvas = document.querySelector<HTMLCanvasElement>(".background-canvas");
    const content = document.querySelector<HTMLElement>(".page-content");
    const returnBtn = document.querySelector<HTMLElement>(".return-button");
    const hitbox = document.querySelector<HTMLElement>(".return-button-hitbox");
    if (!canvas || !content) return;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    let notchProgress = 0;
    let animating = false;
    let animationFrame: number;

    const shapePath = (
      ctx: CanvasRenderingContext2D,
      W: number,
      H: number,
      R0: number,
      nw: number,
      nh: number,
      rf: number,
    ) => {
      const R = Math.max(0, Math.min(R0, W / 2, H / 2));
      ctx.beginPath();
      ctx.moveTo(W - R, 0);
      ctx.arc(W - R, R, R, -Math.PI / 2, 0);
      ctx.arc(W - R, H - R, R, 0, Math.PI / 2);
      ctx.arc(R, H - R, R, Math.PI / 2, Math.PI);

      const cx = nw - rf,
        cy = nh - rf,
        rho = R + rf;
      const inD = (x: number, y: number) =>
        x < cx + rho && y < cy + rho && (x <= cx || y <= cy || Math.hypot(x - cx, y - cy) < rho);

      if (!(nw > 0 && nh > 0) || !inD(R, R)) {
        ctx.arc(R, R, R, Math.PI, 1.5 * Math.PI);
        ctx.closePath();
        return;
      }

      let yB: number, thB: number;
      if (R <= cx) {
        yB = cy + rho;
        thB = -Math.PI / 2;
      } else {
        const dx = R - cx;
        yB = cy + Math.sqrt(rho * rho - dx * dx);
        thB = Math.atan2(cy - yB, cx - R);
      }

      let xA: number, thA: number;
      if (R <= cy) {
        xA = cx + rho;
        thA = -Math.PI;
      } else {
        const dy = R - cy;
        xA = cx + Math.sqrt(rho * rho - dy * dy);
        thA = Math.atan2(cy - R, cx - xA);
      }

      if (thA > 0) thA -= 2 * Math.PI;
      if (thB > 0) thB -= 2 * Math.PI;

      ctx.lineTo(0, yB);
      ctx.arc(R, yB, R, -Math.PI, thB);
      if (rf > 0) ctx.arc(cx, cy, rf, thB + Math.PI, thA + Math.PI, true);
      else ctx.lineTo(nw, nh);
      ctx.arc(xA, R, R, thA, -Math.PI / 2);
      ctx.closePath();
    };

    const easeInOutCubic = (t: number) =>
      t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;

    const draw = () => {
      const dpr = devicePixelRatio || 1;
      const rect = canvas.getBoundingClientRect();
      const w = rect.width,
        h = rect.height;

      if (canvas.width !== Math.round(w * dpr) || canvas.height !== Math.round(h * dpr)) {
        canvas.width = Math.round(w * dpr);
        canvas.height = Math.round(h * dpr);
      }

      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);

      const rootStyles = getComputedStyle(document.documentElement);
      const R = 32;
      const maxNotchW = Number.parseFloat(rootStyles.getPropertyValue("--notch-size")) || 72;
      const maxNotchH = maxNotchW;
      const rf = Number.parseFloat(rootStyles.getPropertyValue("--notch-radius")) || 24;

      const progress = easeInOutCubic(notchProgress);
      const notchW = maxNotchW * progress;
      const notchH = maxNotchH * progress;

      shapePath(ctx, w, h, R, notchW, notchH, rf);

      const bgColor = getComputedStyle(document.documentElement)
        .getPropertyValue("--primary-background-color")
        .trim();
      ctx.fillStyle = bgColor || "#ffffff";
      ctx.fill();

      if (returnBtn) {
        const offset = matchMedia("(max-width: 768px)").matches ? 32 : 36;
        returnBtn.style.left = `${offset}px`;
        returnBtn.style.top = `${offset}px`;
      }
    };

    const animateNotch = (targetProgress: number, duration = 500) => {
      if (animating) cancelAnimationFrame(animationFrame);

      const startProgress = notchProgress;
      const startTime = performance.now();
      animating = true;

      const animate = (currentTime: number) => {
        const elapsed = currentTime - startTime;
        const t = Math.min(elapsed / duration, 1);
        notchProgress = startProgress + (targetProgress - startProgress) * easeInOutCubic(t);
        draw();

        if (t < 1) {
          animationFrame = requestAnimationFrame(animate);
        } else {
          animating = false;
        }
      };
      animationFrame = requestAnimationFrame(animate);
    };

    const updateNotch = (cameraX: number) => {
      const targetProgress = cameraX > 0 ? 1 : 0;
      animateNotch(targetProgress);
      if (returnBtn && hitbox) {
        if (cameraX > 0) {
          returnBtn.classList.add("visible");
          hitbox.classList.add("visible");
        } else {
          returnBtn.classList.remove("visible");
          hitbox.classList.remove("visible");
        }
      }
    };

    draw();
    updateNotch(Number(content.dataset.cameraX) || 0);

    const observer = new MutationObserver(() => {
      updateNotch(Number(content.dataset.cameraX) || 0);
    });
    observer.observe(content, { attributes: true, attributeFilter: ["data-camera-x"] });

    window.addEventListener("resize", draw);

    const mediaQuery = matchMedia("(prefers-color-scheme: dark)");
    mediaQuery.addEventListener("change", draw);

    const themeObserver = new MutationObserver(draw);
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
  };

  const setupPageGrid = () => {
    const content = document.querySelector<HTMLElement>(".page-content");
    const grid = document.querySelector<HTMLElement>(".page-grid");
    if (!content || !grid) return;

    const menuLinks = [...document.querySelectorAll<HTMLAnchorElement>(".menu-item[href]")];

    const setupArticleToolbar = (root: ParentNode) => {
      root.querySelectorAll<HTMLElement>(".articles").forEach((articles) => {
        const upperTools = articles
          .closest<HTMLElement>(".article-wrapper")
          ?.querySelector<HTMLElement>(".upper-tools");
        if (!upperTools) return;

        const updateToolbar = () => {
          const maxScrollTop = Math.max(0, articles.scrollHeight - articles.clientHeight);
          const hasOverflow = maxScrollTop > 1;
          const atTop = articles.scrollTop <= 1;
          const atBottom = articles.scrollTop >= maxScrollTop - 1;
          upperTools.classList.toggle("is-not-scrollable", !hasOverflow);
          upperTools.classList.toggle("is-at-top", atTop);
          upperTools.classList.toggle("is-at-bottom", atBottom);
        };

        articles.addEventListener("scroll", updateToolbar, { passive: true });
        new ResizeObserver(updateToolbar).observe(articles);
        if (articles.firstElementChild)
          new ResizeObserver(updateToolbar).observe(articles.firstElementChild);
        updateToolbar();
      });
    };

    setupArticleToolbar(content);

    const pageCells = [...document.querySelectorAll<HTMLElement>(".page-cell")];
    const pageGridMap = new Map<string, { x: number; y: number }>();
    pageCells.forEach((cell) => {
      const path = cell.dataset.pagePath;
      const x = Number(cell.dataset.gridX);
      const y = Number(cell.dataset.gridY);
      if (path) {
        pageGridMap.set(path, { x, y });
      }
    });

    const moveCamera = (x: number, y: number, path: string) => {
      content.dataset.cameraX = String(x);
      content.dataset.cameraY = String(y);
      grid.style.setProperty("--camera-x", String(x));
      grid.style.setProperty("--camera-y", String(y));

      const menuPath = /^\/(?:comments\/)?[^/]+\/[^/]+$/.test(path) ? "/" : path;
      menuLinks.forEach((link) => {
        link.classList.toggle("active", link.pathname === menuPath);
      });
    };

    const navigateTo = async (
      path: string,
      options: { pushHistory?: boolean; returnPath?: string } = {},
    ) => {
      const targetPath = new URL(path, window.location.href).pathname.replace(/\/$/, "") || "/";
      const wasOnComments = /^\/comments\/[^/]+\/[^/]+$/.test(window.location.pathname);
      let pagePath = targetPath;
      let cellSelector: string | undefined;
      let contentSelector: string | undefined;

      if (/^\/comments\/[^/]+\/[^/]+$/.test(targetPath)) {
        pagePath = "/comments";
        cellSelector = '.page-cell[data-page-path="/comments"]';
        contentSelector = ".comments-page";
      } else if (/^\/[^/]+\/[^/]+$/.test(targetPath) && !pageGridMap.has(targetPath)) {
        pagePath = "/article";
        cellSelector = '.page-cell[data-page-path="/article"]';
        contentSelector = ".article-wrapper";
      } else if (!pageGridMap.has(targetPath)) {
        pagePath = "/404";
      }

      const position = pageGridMap.get(pagePath);
      if (!position) return;

      if (cellSelector && contentSelector) {
        const cell = document.querySelector<HTMLElement>(cellSelector);
        if (!cell) return;

        if (pagePath === "/comments") {
          content.dataset.parentReturnPath = content.dataset.returnPath || "/";
        }

        const response = await fetch(targetPath, { credentials: "same-origin" });
        if (!response.ok) throw new Error(`Page request failed: ${response.status}`);
        const parsed = new DOMParser().parseFromString(await response.text(), "text/html");
        const nextContent = parsed.querySelector<HTMLElement>(contentSelector);
        if (!nextContent) throw new Error(`Page content is missing: ${contentSelector}`);
        cell.replaceChildren(nextContent);
        if (contentSelector === ".article-wrapper") setupArticleToolbar(cell);
        document.title = parsed.title;
      }

      if (options.returnPath) content.dataset.returnPath = options.returnPath;
      else if (pagePath === "/article" && wasOnComments) {
        content.dataset.returnPath = content.dataset.parentReturnPath || "/";
      }
      if (pagePath === "/404") {
        if (!options.returnPath) content.dataset.returnPath = window.location.pathname;
        document.title = `404 · ${document.title.split(" · ").slice(-1)[0]}`;
      }
      moveCamera(position.x, position.y, targetPath);
      if (options.pushHistory && window.location.pathname !== targetPath) {
        history.pushState({}, "", targetPath);
      }
    };

    menuLinks.forEach((link) => {
      link.addEventListener("click", (event) => {
        event.preventDefault();
        navigateTo(new URL(link.href).pathname, { pushHistory: true }).catch(console.error);
      });
    });

    document.addEventListener("click", async (event) => {
      const target = event.target as HTMLElement;

      const toolbarButton = target.closest<HTMLButtonElement>(
        ".article-wrapper button.toolbar-item",
      );
      if (toolbarButton) {
        const isTop = toolbarButton.classList.contains("to-top");
        const isBottom = toolbarButton.classList.contains("to-bottom");
        if (!isTop && !isBottom) return;

        const articles = toolbarButton
          .closest<HTMLElement>(".article-wrapper")
          ?.querySelector<HTMLElement>(".articles");
        if (!articles) return;

        const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
        articles.scrollTo({
          top: isBottom ? articles.scrollHeight : 0,
          behavior: reducedMotion ? "auto" : "smooth",
        });
        return;
      }

      const internalLink = target.closest<HTMLAnchorElement>("a[href]");
      if (
        !internalLink ||
        event.defaultPrevented ||
        internalLink.target === "_blank" ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      )
        return;

      const targetUrl = new URL(internalLink.href, window.location.href);
      if (targetUrl.origin !== window.location.origin) return;

      const targetPath = targetUrl.pathname.replace(/\/$/, "") || "/";
      const currentPath = window.location.pathname.replace(/\/$/, "") || "/";
      if (/\.[a-z\d]+$/i.test(targetPath)) return;
      if (targetPath === currentPath && targetUrl.hash) return;
      event.preventDefault();
      const returnPath = internalLink.matches("a.archive-item")
        ? "/archive"
        : internalLink.matches("a.home-card-body")
          ? "/"
          : /^\/comments\/[^/]+\/[^/]+$/.test(targetPath)
            ? window.location.pathname
            : undefined;
      navigateTo(targetPath, { pushHistory: true, returnPath }).catch(console.error);
    });

    const hitbox = document.querySelector<HTMLElement>(".return-button-hitbox");
    hitbox?.addEventListener("click", () => {
      navigateTo(content.dataset.returnPath || "/", { pushHistory: true }).catch(console.error);
    });

    window.addEventListener("popstate", () => {
      navigateTo(window.location.pathname).catch(console.error);
    });

    const initialPath = window.location.pathname;
    const initialX = Number(content.dataset.cameraX) || 0;
    const initialY = Number(content.dataset.cameraY) || 0;
    moveCamera(initialX, initialY, initialPath);
  };

  setupBackground();
  setupPageGrid();
</script>
