---
import "../styles/components/sidebar.css";
import { menu } from "../config/menu";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<div class="sidebar-wrapper">
  <div class="upper">
    <nav class="menu" aria-label="Main navigation">
      <span class="active-indicator" aria-hidden="true"></span>
      {menu.map((item) => (
        <a
          class:list={["menu-item", { active: currentPath === item.path }]}
          href={item.path}
          data-index={menu.indexOf(item)}
          aria-label={item.name}
          aria-current={currentPath === item.path ? "page" : undefined}
        >
          <i class={item.icon} aria-hidden="true"></i>
        </a>
      ))}
    </nav>
  </div>

  <div class="lower">
    <div class="theme-control">
      <div class="color-slider" id="theme-slider" aria-hidden="true">
        <input
          class="color-slider-input"
          type="range"
          min="0"
          max="360"
          value="210"
          aria-label="Adjust theme color"
        />
      </div>
      <button class="theme-color" type="button" aria-expanded="false" aria-controls="theme-slider">
        <i class="fa-solid fa-palette"></i>
      </button>
      <button class="theme-mode" type="button" aria-label="切换明暗模式" title="切换明暗模式">
        <i class="fa-solid fa-sun"></i>
      </button>
    </div>
    <div class="settings">
      <i class="fa-solid fa-gear"></i>
    </div>
  </div>
</div>

<script>
  const moveActiveIndicator = (container: HTMLElement, target: HTMLElement | null) => {
    const indicator = container.querySelector<HTMLElement>(".active-indicator");
    if (!indicator) return;
    if (!target) {
      indicator.classList.remove("is-visible");
      indicator.classList.remove("has-active-target");
      return;
    }
    const containerRect = container.getBoundingClientRect();
    const targetRect = target.getBoundingClientRect();
    const isMobile = window.innerWidth <= 768;
    if (isMobile) {
      indicator.style.setProperty("--indicator-x", `${targetRect.left - containerRect.left}px`);
      indicator.style.removeProperty("--indicator-y");
    } else {
      indicator.style.setProperty("--indicator-y", `${targetRect.top - containerRect.top}px`);
      indicator.style.removeProperty("--indicator-x");
    }
    if (indicator.classList.contains("is-visible")) {
      indicator.classList.add("has-active-target");
    }
    indicator.classList.add("is-visible");
  };

  const setupSidebarIndicators = () => {
    const menu = document.querySelector<HTMLElement>(".menu");
    if (!menu) return;
    const updateMenuIndicator = () => {
      const currentPath = window.location.pathname.replace(/\/$/, "") || "/";
      const menuPath = /^\/[^/]+\/[^/]+$/.test(currentPath) ? "/" : currentPath;
      const items = [...menu.querySelectorAll<HTMLAnchorElement>(".menu-item")];
      const active = items.find(
        (item) => (new URL(item.href).pathname.replace(/\/$/, "") || "/") === menuPath,
      );
      items.forEach((item) => {
        const isActive = item === active;
        item.classList.toggle("active", isActive);
        if (isActive) item.setAttribute("aria-current", "page");
        else item.removeAttribute("aria-current");
      });
      moveActiveIndicator(menu, active ?? null);
    };
    menu.addEventListener("click", (event) => {
      const item = (event.target as HTMLElement).closest<HTMLElement>(".menu-item");
      if (item) moveActiveIndicator(menu, item);
    });
    window.addEventListener("resize", () => {
      updateMenuIndicator();
    });
    window.addEventListener("popstate", updateMenuIndicator);
    updateMenuIndicator();
  };

  const setupThemeControl = () => {
    const control = document.querySelector<HTMLElement>(".theme-control");
    const button = control?.querySelector<HTMLButtonElement>(".theme-color");
    const modeButton = control?.querySelector<HTMLButtonElement>(".theme-mode");
    const slider = control?.querySelector<HTMLInputElement>(".color-slider-input");
    if (!control || !button || !modeButton || !slider) return;

    const modeIcon = modeButton.querySelector<HTMLElement>("i");
    const systemTheme = matchMedia("(prefers-color-scheme: light)");
    const applyTheme = (theme: "light" | "dark") => {
      document.documentElement.dataset.theme = theme;
      modeButton.setAttribute("aria-pressed", String(theme === "dark"));
      if (modeIcon) {
        modeIcon.className = theme === "light" ? "fa-solid fa-sun" : "fa-solid fa-moon";
      }
    };
    const savedTheme = localStorage.getItem("theme") as "light" | "dark" | null;
    const savedHue = localStorage.getItem("theme-hue");
    if (savedHue) {
      slider.value = savedHue;
    }
    applyTheme(savedTheme ?? (systemTheme.matches ? "light" : "dark"));

    const updateThemeColor = () => {
      const hue = Number(slider.value);
      document.documentElement.style.setProperty("--primary-color", `hsl(${hue} 70% 50%)`);
      document.documentElement.style.setProperty("--primary-color-light", `hsl(${hue} 70% 95%)`);
      document.documentElement.style.setProperty("--primary-color-dark", `hsl(${hue} 70% 20%)`);
      document.documentElement.style.setProperty("--primary-color-rgb", `${hslToRgb(hue, 70, 50)}`);
      document.documentElement.style.setProperty("--secondary-color", `hsl(${hue} 15% 65%)`);
      slider.style.setProperty("--slider-hue", String(hue));
      localStorage.setItem("theme-hue", String(hue));
    };

    const hslToRgb = (h: number, s: number, l: number) => {
      s /= 100;
      l /= 100;
      const k = (n: number) => (n + h / 30) % 12;
      const a = s * Math.min(l, 1 - l);
      const f = (n: number) => l - a * Math.max(-1, Math.min(k(n) - 3, Math.min(9 - k(n), 1)));
      return `${Math.round(255 * f(0))}, ${Math.round(255 * f(8))}, ${Math.round(255 * f(4))}`;
    };
    const setOpen = (open: boolean) => {
      control.classList.toggle("is-open", open);
      button.setAttribute("aria-expanded", String(open));
      slider.parentElement?.setAttribute("aria-hidden", String(!open));
      slider.tabIndex = open ? 0 : -1;
    };

    button.addEventListener("click", () => {
      button.classList.add("active");
      modeButton.classList.remove("active");
      setOpen(!control.classList.contains("is-open"));
    });
    modeButton.addEventListener("click", () => {
      modeButton.classList.add("active");
      button.classList.remove("active");
      setOpen(false);
      const nextTheme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      applyTheme(nextTheme);
      localStorage.setItem("theme", nextTheme);
    });
    systemTheme.addEventListener("change", (event) => {
      if (!localStorage.getItem("theme")) applyTheme(event.matches ? "dark" : "light");
    });
    slider.addEventListener("input", updateThemeColor);
    document.addEventListener("pointerdown", (event) => {
      if (!control.contains(event.target as Node)) setOpen(false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });
    slider.tabIndex = -1;
    updateThemeColor();
  };
  setupSidebarIndicators();
  setupThemeControl();
</script>
