---
import "../styles/components/sidebar.css";
import { menu } from "../config/menu";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<div class="sidebar-wrapper">
  <div class="upper">
    <nav class="menu" aria-label="Main navigation">
      <span class="active-indicator" aria-hidden="true"></span>
      {menu.map((item) => (
        <a
          class:list={["menu-item", { active: currentPath === item.path }]}
          href={item.path}
          data-index={menu.indexOf(item)}
          aria-label={item.name}
          aria-current={currentPath === item.path ? "page" : undefined}
        >
          <i class={item.icon} aria-hidden="true"></i>
        </a>
      ))}
    </nav>
  </div>

  <div class="lower">
    <div class="theme-control">
      <div class="color-slider" id="theme-slider" aria-hidden="true">
        <input
          class="color-slider-input"
          type="range"
          min="0"
          max="360"
          value="120"
          aria-label="Adjust theme color"
        />
      </div>
      <button class="theme-color" type="button" aria-expanded="false" aria-controls="theme-slider">
        <i class="fa-solid fa-palette"></i>
      </button>
      <button class="theme-mode" type="button" aria-label="Theme settings">
        <i class="fa-solid fa-sun"></i>
      </button>
    </div>
    <div class="settings">
      <i class="fa-solid fa-gear"></i>
    </div>
  </div>
</div>

<script>
  const moveActiveIndicator = (container: HTMLElement, target: HTMLElement | null) => {
    const indicator = container.querySelector<HTMLElement>(".active-indicator");
    if (!indicator) return;
    if (!target) {
      indicator.classList.remove("is-visible");
      indicator.classList.remove("has-active-target");
      return;
    }
    const containerRect = container.getBoundingClientRect();
    const targetRect = target.getBoundingClientRect();
    indicator.style.setProperty("--indicator-y", `${targetRect.top - containerRect.top}px`);
    if (indicator.classList.contains("is-visible")) {
      indicator.classList.add("has-active-target");
    }
    indicator.classList.add("is-visible");
  };

  const setupSidebarIndicators = () => {
    const menu = document.querySelector<HTMLElement>(".menu");
    if (!menu) return;
    const updateMenuIndicator = () => {
      const currentPath = window.location.pathname.replace(/\/$/, "") || "/";
      const menuPath = /^\/[^/]+\/[^/]+$/.test(currentPath) ? "/" : currentPath;
      const items = [...menu.querySelectorAll<HTMLAnchorElement>(".menu-item")];
      const active = items.find(
        (item) => (new URL(item.href).pathname.replace(/\/$/, "") || "/") === menuPath,
      );
      items.forEach((item) => {
        const isActive = item === active;
        item.classList.toggle("active", isActive);
        if (isActive) item.setAttribute("aria-current", "page");
        else item.removeAttribute("aria-current");
      });
      moveActiveIndicator(menu, active ?? null);
    };
    menu.addEventListener("click", (event) => {
      const item = (event.target as HTMLElement).closest<HTMLElement>(".menu-item");
      if (item) moveActiveIndicator(menu, item);
    });
    window.addEventListener("resize", () => {
      updateMenuIndicator();
    });
    window.addEventListener("popstate", updateMenuIndicator);
    updateMenuIndicator();
  };

  const setupThemeControl = () => {
    const control = document.querySelector<HTMLElement>(".theme-control");
    const button = control?.querySelector<HTMLButtonElement>(".theme-color");
    const modeButton = control?.querySelector<HTMLButtonElement>(".theme-mode");
    const slider = control?.querySelector<HTMLInputElement>(".color-slider-input");
    if (!control || !button || !modeButton || !slider) return;

    const updateThemeColor = () => {
      const hue = Number(slider.value);
      document.documentElement.style.setProperty("--primary-color", `hsl(${hue} 100% 33%)`);
      document.documentElement.style.setProperty("--secondary-color", `hsl(${hue} 30% 65%)`);
      slider.style.setProperty("--slider-hue", String(hue));
    };
    const setOpen = (open: boolean) => {
      control.classList.toggle("is-open", open);
      button.setAttribute("aria-expanded", String(open));
      slider.parentElement?.setAttribute("aria-hidden", String(!open));
      slider.tabIndex = open ? 0 : -1;
    };

    button.addEventListener("click", () => {
      button.classList.add("active");
      modeButton.classList.remove("active");
      setOpen(!control.classList.contains("is-open"));
    });
    modeButton.addEventListener("click", () => {
      modeButton.classList.add("active");
      button.classList.remove("active");
      setOpen(false);
    });
    slider.addEventListener("input", updateThemeColor);
    document.addEventListener("pointerdown", (event) => {
      if (!control.contains(event.target as Node)) setOpen(false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });
    slider.tabIndex = -1;
    updateThemeColor();
  };
  setupSidebarIndicators();
  setupThemeControl();
</script>
